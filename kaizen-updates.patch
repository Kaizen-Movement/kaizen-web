+            <div>
+              <p className="font-mono text-[10px] uppercase text-bone/30">Member Since</p>
+              <p className="mt-0.5 text-sm text-bone">
+                {profile ? new Date(profile.created_at).toLocaleDateString() : "—"}
+              </p>
+            </div>
